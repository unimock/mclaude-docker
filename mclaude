#!/bin/sh

# Version, baked in at deploy time (= the VERSION file = the bundled Claude Code
# release). Wrapper users update solely by deploying a new copy of this script: it
# reports this version AND pins the matching image tag it runs, so the script is the
# single update vehicle (see README).
MCLAUDE_VERSION="2.1.314"
MCLAUDE_IMAGE="unimock/mclaude:${MCLAUDE_VERSION}"

# mclaude's own options (--mclaude-*) may appear anywhere among the args; they are
# taken out here and everything else passes through to claude unchanged.
#   --mclaude-version       report the wrapper/image build (`--version` is claude's)
#   --mclaude-docker        mount the host's Docker socket + ~/.mclaude/.docker
#   --mclaude-host-network  run the container with `--network host`
OPT_DOCKER=
OPT_HOST_NETWORK=
n=$#
while [ "$n" -gt 0 ]; do
  case "$1" in
    --mclaude-version)
      echo "mclaude ${MCLAUDE_VERSION}"
      exit 0
      ;;
    --mclaude-docker)       OPT_DOCKER=1 ;;
    --mclaude-host-network) OPT_HOST_NETWORK=1 ;;
    --mclaude-*)
      echo "mclaude: unknown option '$1'" >&2
      exit 2
      ;;
    *) set -- "$@" "$1" ;;
  esac
  shift
  n=$((n - 1))
done

if [ "$PWD" = "$HOME" ]; then
  echo "Error: claude must not be run from the home directory." >&2
  exit 1
fi

# Trusted areas: if $PWD lies at or below a directory listed in
# ~/.mclaude/trusted_areas, mount that directory instead of just $PWD. claude
# still starts in $PWD (CLAUDE_WORKDIR), but sees the whole tree. Each line is
# `path | extra docker run args` (fields split on `|`, trailing fields optional,
# `~` allowed, `#` comments). The longest matching entry wins, and only its args
# are used. Nothing extra (e.g. the Docker socket or a .gitconfig) is mounted
# unless an area's args or a --mclaude-* option ask for it.
MOUNT_DIR="$PWD"
EXTRA_ARGS=
TRUSTED_AREAS_FILE="$HOME/.mclaude/trusted_areas"
# First run: drop a commented-out template (no active entries → behaviour unchanged).
if [ ! -e "$TRUSTED_AREAS_FILE" ]; then
  mkdir -p "$HOME/.mclaude"
  cat > "$TRUSTED_AREAS_FILE" <<'EOT'
# mclaude trusted areas
#
# If mclaude is started at or below one of these directories, the whole
# directory is mounted into the container, while claude still starts in the
# current directory. The longest matching entry wins; / and $HOME itself are
# refused.
#
# Format: one area per line, fields separated by `|`, trailing fields optional:
#   path | extra docker run args
# The path is absolute, a leading ~ means $HOME. The args are split on
# whitespace (no quoting, no globbing) and passed to `docker run`; in them a
# ~/ at the start of a word or right after `:` or `=` also means $HOME.
#
# Docker inside the container (socket + registry creds for `docker login`/push)
# is opt-in per area (or per run with --mclaude-docker); the socket makes the
# area root-equivalent on the host:
#   -v /var/run/docker.sock:/var/run/docker.sock -v ~/.mclaude/.docker:/home/claude/.docker
#
# No .gitconfig is mounted by default; mount one per area (the source file
# must exist, else Docker creates a root-owned directory in its place):
#   -v ~/.mclaude/.gitconfig:/home/claude/.gitconfig
#
# Examples:
#~/MyGits      | -v /var/run/docker.sock:/var/run/docker.sock -v ~/.mclaude/.docker:/home/claude/.docker -v ~/.mclaude/.gitconfig:/home/claude/.gitconfig
#~/web         | -p 8080:8080 -e FOO=bar
#/srv/my work  | --network host
#~/customer-x  | -v ~/.mclaude/gitconfig.customer-x:/home/claude/.gitconfig
EOT
fi

# Strip leading and trailing whitespace from $1.
trim() {
  _t="$1"
  _t="${_t#"${_t%%[![:space:]]*}"}"
  _t="${_t%"${_t##*[![:space:]]}"}"
  printf '%s' "$_t"
}

# Expand ~/ in a trusted-area arg: at the start of the word and right after
# each `:` or `=` (e.g. `-v ~/a:~/b`, `--env=DIR=~/x`). Nothing else expands.
expand_tilde() {
  _w="$1"
  _o=
  # shellcheck disable=SC2088  # matching a literal ~ on purpose
  case "$_w" in
    '~')   printf '%s' "$HOME"; return ;;
    '~/'*) _o="$HOME/"; _w="${_w#\~/}" ;;
  esac
  while :; do
    case "$_w" in
      *[:=]'~/'*)
        _pre="${_w%%[:=]\~/*}"
        _w="${_w#"$_pre"}"
        _sep="${_w%"${_w#?}"}"
        _w="${_w#?\~/}"
        _o="$_o$_pre$_sep$HOME/"
        ;;
      *) break ;;
    esac
  done
  printf '%s' "$_o$_w"
}

if [ -f "$TRUSTED_AREAS_FILE" ]; then
  found=
  best=
  best_args=
  # `_rest` takes any further fields (reserved for future use). `|| [ -n ]`
  # keeps a last line without newline.
  while IFS='|' read -r area args _rest || [ -n "$area" ]; do
    area=$(trim "$area")
    case "$area" in ''|'#'*) continue ;; esac
    args=$(trim "$args")
    # shellcheck disable=SC2088  # matching a literal ~ on purpose
    case "$area" in
      '~')   area="$HOME" ;;
      '~/'*) area="$HOME/${area#\~/}" ;;
    esac
    case "$area" in
      /*) ;;
      *) echo "mclaude: ignoring non-absolute trusted area '$area' in $TRUSTED_AREAS_FILE" >&2; continue ;;
    esac
    # Strip trailing slashes ("/" becomes "", which matches everything below).
    while [ "${area%/}" != "$area" ]; do area="${area%/}"; done
    # Match on a path boundary: /a/b matches /a/b and /a/b/x, but not /a/bc.
    case "$PWD/" in "$area"/*) ;; *) continue ;; esac
    if [ -z "$found" ] || [ "${#area}" -gt "${#best}" ]; then
      found=1
      best="$area"
      best_args="$args"
    fi
  done < "$TRUSTED_AREAS_FILE"
  if [ -n "$found" ]; then
    if [ -z "$best" ] || [ "$best" = "${HOME%/}" ]; then
      echo "Error: trusted area '${best:-/}' from $TRUSTED_AREAS_FILE would mount / or the home directory." >&2
      exit 1
    fi
    MOUNT_DIR="$best"
    EXTRA_ARGS="$best_args"
  fi
fi

# Command-line opt-ins. Skipped where the area's args already contain the same
# mount/network, since Docker refuses a duplicate mount point.
if [ -n "$OPT_DOCKER" ]; then
  case " $EXTRA_ARGS " in
    *':/var/run/docker.sock '*|*':/var/run/docker.sock:'*) ;;
    *) EXTRA_ARGS="$EXTRA_ARGS -v /var/run/docker.sock:/var/run/docker.sock" ;;
  esac
  case " $EXTRA_ARGS " in
    *':/home/claude/.docker '*|*':/home/claude/.docker:'*) ;;
    *) EXTRA_ARGS="$EXTRA_ARGS -v ~/.mclaude/.docker:/home/claude/.docker" ;;
  esac
fi
if [ -n "$OPT_HOST_NETWORK" ]; then
  case " $EXTRA_ARGS " in
    *' --network host '*|*' --network=host '*|*' --net host '*|*' --net=host '*) ;;
    *) EXTRA_ARGS="$EXTRA_ARGS --network host" ;;
  esac
fi

# Pre-create the config dir so Docker doesn't auto-create the bind-mount source
# as a root-owned directory (which then needs an in-container chown to fix).
mkdir -p "$HOME/.mclaude/.claude"

# Claude Code keeps its primary state (login/OAuth, onboarding, projects, MCP
# servers) in ~/.claude.json — a sibling of the .claude dir, NOT inside it. Touch
# it as a FILE first so the bind-mount source exists; otherwise Docker would
# auto-create it as a directory and claude would fail to write the JSON.
[ -e "$HOME/.mclaude/.claude.json" ] || touch "$HOME/.mclaude/.claude.json"

# ~/.mclaude/.gitconfig is NOT mounted by default; trusted areas mount it (or
# their own file) via their args. Still seed it from the host's ~/.gitconfig on
# first run, so an area referencing it finds a file (else Docker auto-creates a
# root-owned directory) and the identity carries over.
if [ ! -e "$HOME/.mclaude/.gitconfig" ]; then
  if [ -f "$HOME/.gitconfig" ]; then
    cp "$HOME/.gitconfig" "$HOME/.mclaude/.gitconfig"
  else
    touch "$HOME/.mclaude/.gitconfig"
  fi
fi

# SSH client keys of the container (generated inside by claude-wrapper if missing).
mkdir -p "$HOME/.mclaude/.ssh"
chmod 700 "$HOME/.mclaude/.ssh"

# Docker client config / registry creds (`docker login` inside the container).
# Only mounted when a trusted area or --mclaude-docker asks for it, but created here so Docker never
# auto-creates the mount source as a root-owned directory.
mkdir -p "$HOME/.mclaude/.docker"
chmod 700 "$HOME/.mclaude/.docker"

TZ_NAME=$(cat /etc/timezone 2>/dev/null || readlink -f /etc/localtime | sed 's@.*/zoneinfo/@@')

# Allocate a TTY only when running interactively. With piped input
# (e.g. `echo hi | mclaude -p`) stdin is not a TTY and `-t` would fail
# with "the input device is not a TTY".
TTY_FLAG=
if [ -t 0 ] && [ -t 1 ]; then
  TTY_FLAG=-t
fi

# Build the tail of the docker command in the positional parameters:
#   <area args...> <image> claude-wrapper <claude args...>
# EXTRA_ARGS (from trusted_areas) is split on whitespace on purpose; `set -f`
# keeps a `*` in it from globbing. Each word is ~-expanded and kept as one word,
# so a $HOME with spaces survives. The claude args are appended first and then
# rotated behind the rest.
n=$#
set -f
for word in $EXTRA_ARGS; do
  set -- "$@" "$(expand_tilde "$word")"
done
set -- "$@" "$MCLAUDE_IMAGE" /usr/local/bin/claude-wrapper
while [ "$n" -gt 0 ]; do
  set -- "$@" "$1"
  shift
  n=$((n - 1))
done

exec docker run -i $TTY_FLAG --rm -v "$MOUNT_DIR":"$MOUNT_DIR" \
                         -e CLAUDE_WORKDIR="$PWD" \
                         -e CLAUDE_UID="$(id -u)" \
                         -e CLAUDE_GID="$(id -g)" \
                         -e CLAUDE_USER="$(id -un)" \
                         -e CLAUDE_GROUP="$(id -gn)" \
                         -e TZ="$TZ_NAME" \
                         -e TERM="${TERM:-xterm-256color}" \
                         -e COLORTERM="${COLORTERM:-truecolor}" \
                         -v /etc/localtime:/etc/localtime:ro \
                         -v "$HOME/.mclaude/.ssh":/home/claude/.ssh \
                         -v "$HOME/.mclaude/.claude":/home/claude/.claude \
                         -v "$HOME/.mclaude/.claude.json":/home/claude/.claude.json \
                         "$@"

